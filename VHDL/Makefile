# Makefile automatically generated by ghdl
# Version: GHDL 4.1.0 (Ubuntu 4.1.0+dfsg-0ubuntu2.1) [Dunoon edition] - static elaboration, mcode JIT code generator
# Command used to generate this makefile:
# /usr/bin/ghdl-mcode --gen-makefile --workdir=work --std=08 -frelaxed-rules -Wno-specs tb_core --wave=wave.ghw --disp-tree

# GHDL documentation: https://ghdl.github.io/ghdl/index.html

# ================
# Set the name of the top entity for the simulation here
TOP_ENTITY ?= TestAEA
STOP_TIME ?= 10us
NO_WAVE_FILE ?= false
# ================


WORKDIR=build
WAVEFORM_FILE=wave.ghw


# ================
# GHDL command configuration
GHDL=/usr/bin/env ghdl
GHDLFLAGS := --workdir=$(WORKDIR) --std=08 -frelaxed-rules -Wall -Wno-specs -Wno-missing-assoc
GHDLRUNFLAGS := --stop-time=$(STOP_TIME) --ieee-asserts=disable \
	--backtrace-severity=error --assert-level=failure 

# Other useful flags:  --disp-tree=inst --disp-time --asserts=disable-at-0

ifeq ($(NO_WAVE_FILE),false)
	GHDLRUNFLAGS += --wave=$(WAVEFORM_FILE)
endif


# ================
# Collecting all VHDL source files 

VHD_SOURCES := $(shell find . -name "*.vhd")
# If we have some files we do not want to compile, we can filter them here
VHD_SOURCES := $(filter-out ./hdl/pdlab/utilities/MixedModeClockManager.vhd some-other-file.vhd, $(VHD_SOURCES))


# ================
# Makefile targets

.PHONY: all elab run init import clean

# Default target : elaborate
all : elab


# Import source file
# Files are parsed but not analyzed 
import init : |  $(WORKDIR)
	$(GHDL) -i $(GHDLFLAGS) $(VHD_SOURCES) 


# Analyze and elaborate the design  
elab : | $(WORKDIR) 
	$(GHDL) -m $(GHDLFLAGS) $(TOP_ENTITY)


# Run a simulation of the design
run : elab |  $(WORKDIR)
	$(GHDL) -r $(GHDLFLAGS) $(TOP_ENTITY) $(GHDLRUNFLAGS)



clean:
	-rm -rf $(WORKDIR) 
	-rm -f $(WAVEFORM_FILE) 

$(WORKDIR): 
	mkdir -p $@ 
